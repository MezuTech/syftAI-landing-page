---
import { site } from '../../data/site';
import Reveal from '../site/Reveal.astro';
---

<Reveal class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
  <h2 class="display max-w-[20rem] text-display text-ink">Get in touch.</h2>

  <div class="max-w-[38rem]">
    <p class="text-[1.0625rem] leading-relaxed text-body">
      Bug reports, early-access requests, or a question about one of the apps —
      email is the fastest way through. I read everything.
    </p>

    <ul class="mt-10 border-t border-rule">
      <li class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule py-5">
        <span class="label text-faint">Email</span>
        <a href={`mailto:${site.email}`} class="link-rule text-[1.0625rem] text-ink">
          {site.email}
        </a>
      </li>
      <li class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule py-5">
        <span class="label text-faint">Code</span>
        <a
          href={site.github}
          rel="me noopener"
          class="link-rule text-[1.0625rem] text-ink"
        >
          github.com/MezuTech
        </a>
      </li>
    </ul>
  </div>
</Reveal>
