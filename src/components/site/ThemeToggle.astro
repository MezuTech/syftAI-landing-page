---
// Cycles light → dark → system. The resolved theme is written to
// <html data-theme> by the inline script in BaseLayout before first paint;
// this only has to keep the stored preference and the DOM in step.
---

<button
  type="button"
  id="theme-toggle"
  class="label group inline-flex items-center gap-1.5 text-muted transition-colors hover:text-ink"
  aria-live="polite"
>
  <span class="relative grid h-3.5 w-3.5 place-items-center" aria-hidden="true">
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" data-icon="light" fill="none">
      <circle cx="8" cy="8" r="3.1" fill="currentColor"></circle>
      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
        <path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6"></path>
        <path d="M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1"></path>
      </g>
    </svg>
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" data-icon="dark" fill="none">
      <path
        d="M13.4 9.9A5.7 5.7 0 1 1 6.1 2.6a4.9 4.9 0 0 0 7.3 7.3Z"
        fill="currentColor"></path>
    </svg>
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" data-icon="system" fill="none">
      <rect x="1.8" y="2.6" width="12.4" height="8.6" rx="1.4"
        stroke="currentColor" stroke-width="1.3"></rect>
      <path d="M5.4 13.6h5.2" stroke="currentColor" stroke-width="1.3"
        stroke-linecap="round"></path>
    </svg>
  </span>
  <span data-theme-label>System</span>
</button>

<style>
  /* Only the icon matching the stored preference is shown. */
  #theme-toggle [data-icon] {
    position: absolute;
    opacity: 0;
  }
  :root[data-theme-pref='light'] #theme-toggle [data-icon='light'],
  :root[data-theme-pref='dark'] #theme-toggle [data-icon='dark'],
  :root[data-theme-pref='system'] #theme-toggle [data-icon='system'] {
    opacity: 1;
  }
</style>

<script>
  const ORDER = ['system', 'light', 'dark'] as const;
  type Pref = (typeof ORDER)[number];

  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const label = button?.querySelector('[data-theme-label]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const stored = (): Pref => {
    const value = root.dataset.themePref;
    return ORDER.includes(value as Pref) ? (value as Pref) : 'system';
  };

  const apply = (pref: Pref) => {
    const dark = pref === 'system' ? media.matches : pref === 'dark';
    root.dataset.theme = dark ? 'dark' : 'light';
    root.dataset.themePref = pref;
    try {
      localStorage.setItem('theme', pref);
    } catch {}
    if (label) label.textContent = pref[0].toUpperCase() + pref.slice(1);
    button?.setAttribute('aria-label', `Theme: ${pref}. Click to change.`);
  };

  apply(stored());
  button?.addEventListener('click', () => {
    apply(ORDER[(ORDER.indexOf(stored()) + 1) % ORDER.length]);
  });
  // Follow the OS only while the preference is "system".
  media.addEventListener('change', () => {
    if (stored() === 'system') apply('system');
  });
</script>
