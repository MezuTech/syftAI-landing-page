---
interface Props {
  id?: string;
  /** The mono eyebrow above the heading. */
  eyebrow?: string;
  heading?: string;
  /** Adds the top hairline that separates one section from the last. */
  divide?: boolean;
  narrow?: boolean;
  class?: string;
}
const { id, eyebrow, heading, divide = true, narrow = false, class: cls = '' } = Astro.props;
---

<section id={id} class={`${divide ? 'border-t border-rule' : ''} ${cls}`}>
  <div class={`${narrow ? 'shell-narrow' : 'shell'} py-section`}>
    {
      (eyebrow || heading) && (
        <header class="mb-10 sm:mb-14">
          {eyebrow && <p class="label text-faint">{eyebrow}</p>}
          {heading && (
            <h2 class="display mt-3 max-w-2xl text-title">{heading}</h2>
          )}
        </header>
      )
    }
    <slot />
  </div>
</section>
