---
// A phone, drawn with hairlines rather than a drop-shadowed mockup PNG.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<div
  class={`relative aspect-[9/19] w-full rounded-[2rem] border border-rule-strong bg-paper p-[6px] ${cls}`}
>
  <div class="relative h-full w-full overflow-hidden rounded-[1.65rem] bg-well">
    <slot />
  </div>
  <span
    class="pointer-events-none absolute top-[14px] left-1/2 h-1 w-12 -translate-x-1/2 rounded-full bg-rule-strong/60"
  ></span>
</div>
