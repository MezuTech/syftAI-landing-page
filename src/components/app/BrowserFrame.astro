---
interface Props {
  /** Shown in the address pill. */
  url?: string;
  class?: string;
}
const { url, class: cls = '' } = Astro.props;
---

<div class={`w-full overflow-hidden rounded-xl border border-rule-strong bg-paper ${cls}`}>
  <div class="flex items-center gap-3 border-b border-rule px-4 py-3">
    <span class="flex gap-1.5">
      <span class="h-2 w-2 rounded-full bg-rule-strong"></span>
      <span class="h-2 w-2 rounded-full bg-rule-strong"></span>
      <span class="h-2 w-2 rounded-full bg-rule-strong"></span>
    </span>
    {
      url && (
        <span class="label truncate rounded-full bg-well px-3 py-1 text-faint normal-case tracking-normal">
          {url}
        </span>
      )
    }
  </div>
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-well">
    <slot />
  </div>
</div>
