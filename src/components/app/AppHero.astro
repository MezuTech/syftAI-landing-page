---
import type { ImageMetadata } from 'astro';
import AppIcon from './AppIcon.astro';
import StatusBadge from './StatusBadge.astro';
import PlatformTags from './PlatformTags.astro';
import Reveal from '../site/Reveal.astro';
import { site } from '../../data/site';

interface Props {
  name: string;
  order: number;
  tagline: string;
  summary: string;
  status: 'in-development' | 'private-beta' | 'live';
  progress?: number;
  platforms: readonly ('iOS' | 'Android' | 'Web')[];
  icon: ImageMetadata;
  website?: string;
}
const { name, order, tagline, summary, status, progress, platforms, icon, website } =
  Astro.props;

const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`Early access — ${name}`)}`;
---

<section class="border-b border-rule">
  <div class="shell pt-14 pb-16 sm:pt-20 sm:pb-24">
    <Reveal>
      <AppIcon icon={icon} name={name} class="h-16 w-16 sm:h-20 sm:w-20" />

      <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="label text-faint">{String(order).padStart(2, '0')}</span>
        <span class="h-px w-6 bg-rule-strong" aria-hidden="true"></span>
        <StatusBadge status={status} progress={progress} showProgress />
        <span class="text-faint" aria-hidden="true">·</span>
        <PlatformTags platforms={platforms} />
      </div>

      <h1 class="display mt-6 max-w-[40rem] text-hero text-ink">{name}</h1>

      <p class="display mt-6 max-w-[34rem] text-title italic text-accent-strong">
        {tagline}
      </p>

      <p class="mt-8 max-w-[38rem] text-lead text-body">{summary}</p>

      <div class="mt-11 flex flex-wrap items-center gap-x-8 gap-y-5">
        {
          website ? (
            <a
              href={website}
              class="group inline-flex items-center gap-2.5 rounded-full bg-ink px-5 py-2.5 text-[0.9375rem] font-medium text-canvas transition-colors duration-300 hover:bg-ink/85"
            >
              Open {name}
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 transition-transform duration-300 ease-out-quart group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                <path
                  d="M8 16 16 8M9.5 8H16v6.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          ) : (
            <a
              href={mailto}
              class="inline-flex items-center gap-2.5 rounded-full bg-ink px-5 py-2.5 text-[0.9375rem] font-medium text-canvas transition-colors duration-300 hover:bg-ink/85"
            >
              Ask for early access
            </a>
          )
        }

        <a href="/#apps" class="link-rule text-[0.9375rem] text-body">All four apps</a>
      </div>
    </Reveal>
  </div>
</section>
