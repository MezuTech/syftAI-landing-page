---
import Reveal from '../site/Reveal.astro';

interface Props {
  features: readonly { title: string; body: string }[];
}
const { features } = Astro.props;
---

<Reveal as="ol" class="border-t border-rule">
  {
    features.map((feature, i) => (
      <li class="grid gap-3 border-b border-rule py-7 sm:gap-x-8 sm:py-9 lg:grid-cols-[3rem_1fr_1.35fr]">
        <span class="label hidden pt-1.5 text-faint lg:block">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="max-w-[22rem] text-[1.0625rem] leading-snug font-semibold tracking-[-0.012em] text-ink">
          {feature.title}
        </h3>
        <p class="max-w-[36rem] text-[1.0625rem] leading-relaxed text-body">{feature.body}</p>
      </li>
    ))
  }
</Reveal>
